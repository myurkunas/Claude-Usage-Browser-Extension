{
  "manifest_version": 3,
  "name": "Claude Usage",
  "version": "0.1.0",
  "description": "Shows your Claude usage directly in the chat — no need to visit the settings page.",
  "browser_specific_settings": {
    "gecko": {
      "id": "claude-usage@myurk.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "48": "48x48-logo.png",
    "96": "96x96-logo.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Claude Usage",
    "default_icon": {
      "48": "48x48-logo.png",
      "96": "96x96-logo.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
